<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.order.mapper.AuditLogMapper">

    <resultMap id="AuditLogMap" type="com.mall.order.entity.AuditLog">
        <id property="id" column="id"/>
        <result property="auditId" column="audit_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorRole" column="operator_role"/>
        <result property="action" column="action"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId" column="target_id"/>
        <result property="detail" column="detail"/>
        <result property="result" column="result"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.mall.order.entity.AuditLog">
        INSERT INTO audit_log(audit_id, operator_id, operator_role, action, target_type, target_id,
                              detail, result, created_at)
        VALUES (#{auditId}, #{operatorId}, #{operatorRole}, #{action}, #{targetType}, #{targetId},
                #{detail}, #{result}, #{createdAt})
    </insert>

    <sql id="pageCondition">
        <where>
            <if test="operatorId != null and operatorId != ''">
                AND operator_id = #{operatorId}
            </if>
            <if test="action != null and action != ''">
                AND action = #{action}
            </if>
            <if test="from != null">
                AND created_at &gt;= #{from}
            </if>
            <if test="to != null">
                AND created_at &lt;= #{to}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="AuditLogMap">
        SELECT id, audit_id, operator_id, operator_role, action, target_type, target_id,
               detail, result, created_at
        FROM audit_log
        <include refid="pageCondition"/>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM audit_log
        <include refid="pageCondition"/>
    </select>
</mapper>
